# ================================
# Vibe Tutor Server Environment
# ================================

# Server
PORT=9091

# --------------------------------
# OpenRouter (required for TTS, recommended for text/vision primary)
# --------------------------------
OPENROUTER_API_KEY=

# Primary models
OPENROUTER_TEXT_MODEL=openai/gpt-4o-mini
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini
OPENROUTER_TTS_MODEL=openai/gpt-audio-mini

# Optional comma-separated fallback models
OPENROUTER_TEXT_MODEL_FALLBACKS=
OPENROUTER_VISION_MODEL_FALLBACKS=
OPENROUTER_TTS_MODEL_FALLBACKS=

# Retry & timeout controls (milliseconds)
OPENROUTER_TIMEOUT_MS=20000
OPENROUTER_MAX_RETRIES=2
OPENROUTER_TEXT_TIMEOUT_MS=20000
OPENROUTER_TEXT_MAX_RETRIES=2
OPENROUTER_VISION_TIMEOUT_MS=25000
OPENROUTER_VISION_MAX_RETRIES=2
OPENROUTER_TTS_TIMEOUT_MS=40000
OPENROUTER_TTS_MAX_RETRIES=2

# Optional persona voice override
# Supported voices:
# alloy, ash, ballad, cedar, coral, echo, fable, marin, nova, onyx, sage, shimmer, verse
TTS_VOICE_OPRAH=nova
TTS_VOICE_EINSTEIN=cedar
TTS_VOICE_TRUMP=fable
TTS_VOICE_ELON=onyx
TTS_VOICE_SHERLOCK=verse

# --------------------------------
# Gemini fallback (recommended)
# Used when OpenRouter for text/vision is unavailable or fails.
# --------------------------------
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-flash-latest
GEMINI_VISION_MODEL=gemini-flash-latest

# Notes:
# - OPENROUTER_API_KEY is mandatory for /api/v1/tts.
# - OPENROUTER_MODEL_BASE_URL is no longer used in server/src/index.ts.
